# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# System Directories (Tùy chỉnh theo đường dẫn thực tế trên máy chủ của bạn)
INPUT_DIR=D:/testNLP
OUTPUT_DIR=D:/outputNLP
REPORTS_DIR=D:/outputNLP
CACHE_DIR=data/cache

# Processing Settings
BATCH_SIZE=10
SIMILARITY_THRESHOLD=0.85
OCR_LANG=vie+eng
HEAD_PAGES=2
TAIL_PAGES=1
